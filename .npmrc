# Los scripts de instalacion de dependencias son el vector de supply-chain mas
# comun: se ejecuta codigo arbitrario de terceros al hacer install. Desactivados
# por defecto. Si un paquete legitimo los necesita, se habilita solo para el.
ignore-scripts=true
save-exact=true

# Esto necesita Node 24: ejecuta TypeScript sin compilar y usa node:sqlite.
# Sin engine-strict, npm solo avisa y el fallo aparece luego al arrancar, con un
# error que no dice que el problema es la version. En un despliegue nuevo eso son
# veinte minutos perdidos.
engine-strict=true
