# Copia este archivo FUERA del repo y rellenalo alli.
# Los valores reales nunca se guardan aqui. Ver CLAUDE.md.

# --- apps/api ---
API_PORT=8080
API_HOST=127.0.0.1

# --- storage ---
# En la Pi, mejor en un disco USB que en la tarjeta SD.
DB_PATH=./data/defi.db

# --- collector ---
# Recogida en memoria: por defecto 120000 ms (2 min).
COLLECT_INTERVAL_MS=
# Cada cuanto se vuelca a disco. Un commit por volcado.
# Persistencia: por defecto 360000 ms (6 min).
PERSIST_INTERVAL_MS=

# --- retencion ---
# Dias a resolucion completa antes de comprimir a agregados por hora.
RETAIN_FULL_DAYS=14
# Dias de agregados por hora antes de purgar.
RETAIN_HOURLY_DAYS=365
